rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    // --- Default Deny ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Collections ---
    match /registrations/{registrationId} {
      allow read: if isSignedIn(); // TODO: Add owner validation
      allow create: if isSignedIn() && incoming().status == 'pending';
      allow update: if isAdmin() && incoming().diff(existing()).affectedKeys().hasAny(['status', 'studentId']);
    }

    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }
    
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /support_tickets/{ticketId} {
      allow read: if isSignedIn(); // TODO: Add owner validation
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }
    
    match /leave_requests/{requestId} {
      allow read: if isSignedIn(); // TODO: Add owner validation
      allow create: if isSignedIn();
      allow update: if isAdmin();
    }
    
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Audit logs are immutable
    }
  }
}
