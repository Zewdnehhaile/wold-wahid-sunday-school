            await ctx.reply('ጥያቄውን ማስተናገድ አልተቻለም። እባክዎ ቆይተው ይሞክሩ።', mainMenuKeyboard);
          }
        }
        return;
      }

      // ─── LEAVE REQUEST WIZARD STEPS ───
      if (session.action === 'leave') {
        if (session.step === 'type') {
          session.data.leaveType = text;
          session.step = 'duration';
          await ctx.reply(
            '📅 *የፈቃድ ጊዜውን ያስገቡ:*\nPlease enter the duration or dates of leave:\n(ምሳሌ፡ ለ 2 ሳምንት / ከጥቅምት 10 እስከ 24)',
            cancelKeyboard
          );
        } else if (session.step === 'duration') {
          session.data.duration = text;
          session.step = 'reason';
          await ctx.reply(
            '📝 *የፈቃዱን ዝርዝር ምክንያት ይግለጹ:*\nPlease provide the detailed reason for your leave:',
            cancelKeyboard
          );
        } else if (session.step === 'reason') {
          session.data.reason = text;
          const requestNumber = 'WW-LV-' + Math.floor(100 + Math.random() * 900);

          try {
            await db.collection('leave_requests').add({
              requestNumber,
              studentName: ctx.from?.first_name || 'Student',
              telegramId: telegramId,
              telegramUsername: ctx.from?.username || '',
              leaveType: session.data.leaveType,
              duration: session.data.duration,
              reason: session.data.reason,
              status: 'pending',
              createdAt: new Date().toISOString()
            });

            userSessions.delete(telegramId);

            await ctx.reply(
              `✅ *የፈቃድ ጥያቄዎ ተመዝግቧል!*\n` +
              `*Leave Request Submitted!*\n\n` +
              `📋 *Request #:* \`${requestNumber}\`\n` +
              `⏳ *Status:* በመጠባበቅ ላይ (Pending Review)\n\n` +
              `የክፍል ኃላፊዎ ጥያቄዎን መርምረው ውሳኔውን ያሳውቁዎታል።`,
              { parse_mode: 'Markdown', ...mainMenuKeyboard }
            );
          } catch (err) {
            console.error('Failed to submit leave request:', err);
            await ctx.reply('የፈቃድ ጥያቄውን ማስገባት አልተቻለም።', mainMenuKeyboard);
          }
        }
        return;
      }
    });

    // Handle polling error events gracefully (e.g. 409 Conflict if another instance is running)
    let hasLogged409 = false;
    if (typeof botInstance.on === 'function') {
      botInstance.on('polling_error', (err: any) => {
        const errorMsg = err?.message || String(err);
        if (errorMsg.includes('409') || errorMsg.includes('Conflict')) {
          if (!hasLogged409) {
            console.warn('⚠️ Telegram bot polling notice: Another bot instance is currently active or polling (409 Conflict). Retrying automatically in background.');
            hasLogged409 = true;
          }
          return;
        }
        console.warn('Telegram bot polling warning:', errorMsg);
      });
    }

    // Start background polling safely with explicit callback_query support
    

    console.log('✅ Real interactive Telegram bot initialized successfully.');
  } catch (err) {
    console.error('Failed to initialize Telegram bot:', err);
  }
}

