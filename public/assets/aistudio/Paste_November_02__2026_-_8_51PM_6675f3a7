    botInstance.hears = (keywords: string | string[] | RegExp, handler: Function) => {
      const list = Array.isArray(keywords) ? keywords : [keywords];
      botInstance.on('message', async (msg: any) => {
        const text = msg.text || '';
        const matches = list.some(k => 
          k instanceof RegExp ? k.test(text) : text.includes(k)
        );
        if (matches) await handler(msg, () => {});
      });
    };

    botInstance.command = (cmd: string, handler: Function) => {
