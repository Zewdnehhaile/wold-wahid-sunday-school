rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Registrations: Public creation & read (Telegram bot & web intake)
    match /registrations/{document=**} {
      allow read, write: if true;
    }

    // Students / Members profiles
    match /students/{document=**} {
      allow read, write: if true;
    }

    match /members/{document=**} {
      allow read, write: if true;
    }

    // Attendance logs
    match /attendance/{document=**} {
      allow read, write: if true;
    }

    // Classes & Sunday school schedules
    match /classes/{document=**} {
      allow read, write: if true;
    }

    // Support tickets from students & bot
    match /support_tickets/{document=**} {
      allow read, write: if true;
    }

    // Leave requests
    match /leave_requests/{document=**} {
      allow read, write: if true;
    }

    // Sessions & Admin Logs
    match /sessions/{document=**} {
      allow read, write: if true;
    }

    match /admins/{document=**} {
      allow read, write: if true;
    }

    match /users/{document=**} {
      allow read, write: if true;
    }

    match /audit_logs/{document=**} {
      allow read, write: if true;
    }

    match /notifications/{document=**} {
      allow read, write: if true;
    }
  }
}
